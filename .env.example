# Aplicación
PORT=3000
FRONTEND_PORT=5173
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000

# PostgreSQL (valores locales de ejemplo; reemplazar la contraseña en .env)
# En Vercel/Neon utilizar DATABASE_URL y dejar los DB_* para el entorno local.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_torneos
DB_USER=torneos
DB_PASSWORD=reemplazar_con_clave_local
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5

# Autenticación (generar un valor largo y aleatorio en .env)
JWT_SECRET=reemplazar_con_secreto_aleatorio
