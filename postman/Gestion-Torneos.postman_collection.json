    {
      "name": "02 - Torneos",
      "description": "Creación, consulta, modificación, cambio de estado y eliminación de torneos.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{authAdminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Listar torneos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tournaments?search=apertura&status=open&modality=league&page=1&limit=10&sortBy=createdAt&order=desc",
            "description": "Consulta pública de torneos vigentes. Se pueden ajustar la búsqueda, el estado, la modalidad, el orden y la paginación desde Params.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Crear torneo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  if (response.data?.id) {",
                  "    pm.collectionVariables.set('tournamentId', response.data.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Torneo de apertura\",\n  \"description\": \"Competencia inicial de la temporada\",\n  \"modality\": \"league\",\n  \"maxParticipants\": 16,\n  \"isTeamTournament\": true,\n  \"minTeamMembers\": 2,\n  \"maxTeamMembers\": 5,\n  \"registrationDeadline\": \"2026-11-01\",\n  \"startDate\": \"2026-11-05\",\n  \"endDate\": \"2026-12-10\",\n  \"organizerId\": {{organizerId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/tournaments",
            "description": "Crea un torneo en estado draft. Si responde 201, guarda automáticamente su ID en tournamentId."
          },
          "response": []
        },
        {
          "name": "Consultar torneo por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tournaments/{{tournamentId}}",
            "description": "Consulta el torneo indicado por la variable tournamentId."
          },
          "response": []
        },
        {
          "name": "Actualizar torneo",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Torneo de apertura actualizado\",\n  \"description\": \"Descripción actualizada desde Postman\",\n  \"modality\": \"league\",\n  \"maxParticipants\": 20,\n  \"isTeamTournament\": true,\n  \"minTeamMembers\": 2,\n  \"maxTeamMembers\": 5,\n  \"registrationDeadline\": \"2026-11-01\",\n  \"startDate\": \"2026-11-05\",\n  \"endDate\": \"2026-12-10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/tournaments/{{tournamentId}}",
            "description": "Actualiza los datos editables del torneo. No modifica organizador, estado ni identificador."
          },
          "response": []
        },
        {
          "name": "Cambiar estado del torneo",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"open\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/tournaments/{{tournamentId}}/status",
            "description": "Aplica una transición de estado válida. Para inscribir equipos el torneo debe estar open."
          },
          "response": []
        },
        {
          "name": "Descargar reporte PDF",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/pdf"
              }
            ],
            "url": "{{baseUrl}}/api/tournaments/{{tournamentId}}/report",
            "description": "Genera un PDF con la información general, ocupación y equipos activos del torneo. En Postman puede guardarse con Save Response to file."
          },
          "response": []
        },
        {
          "name": "Eliminar torneo",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/tournaments/{{tournamentId}}",
            "description": "Solo elimina físicamente torneos que permanezcan en estado draft."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Equipos",
      "description": "Creación, consulta, modificación y eliminación de equipos.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{authAdminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Listar equipos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/teams?search=&page=1&limit=10",
            "description": "Listado paginado de equipos. El parámetro opcional search permite buscar por nombre o descripción.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Crear equipo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  if (response.data?.id) {",
                  "    pm.collectionVariables.set('teamId', response.data.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Los Halcones\",\n  \"description\": \"Equipo de la categoría principal\",\n  \"captainId\": {{captainId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/teams",
            "description": "Crea un equipo y registra al capitán como primer integrante. Si responde 201, guarda su ID en teamId."
          },
          "response": []
        },
        {
          "name": "Crear mi equipo como participante",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authParticipantToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mi equipo\",\n  \"description\": \"Equipo creado por su capitán\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/teams",
            "description": "Usá una cuenta que tenga el rol participante. La API toma el capitán de la sesión y lo agrega como primer integrante. Debe responder 201."
          },
          "response": []
        },
        {
          "name": "Consultar equipo por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/teams/{{teamId}}",
            "description": "Consulta el equipo indicado por la variable teamId.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Actualizar equipo",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Los Halcones renovados\",\n  \"description\": \"Descripción actualizada desde Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/teams/{{teamId}}",
            "description": "Actualiza nombre y descripción. No cambia el capitán ni el identificador."
          },
          "response": []
        },
        {
          "name": "Eliminar equipo",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/teams/{{teamId}}",
            "description": "Requiere el token de un administrador o del capitán del equipo indicado en teamId. Devuelve 403 para otros usuarios y 409 si el equipo tiene historial de inscripciones."
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Integrantes",
      "description": "Administración de integrantes pertenecientes a un equipo.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{authAdminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Listar integrantes del equipo",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/teams/{{teamId}}/members",
            "description": "Lista integrantes e indica cuál es el capitán."
          },
          "response": []
        },
        {
          "name": "Agregar integrante al equipo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/teams/{{teamId}}/members",
            "description": "Agrega el usuario indicado por userId al equipo indicado por teamId."
          },
          "response": []
        },
        {
          "name": "Eliminar integrante del equipo",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/teams/{{teamId}}/members/{{userId}}",
            "description": "Elimina un integrante. El capitán no puede ser eliminado mediante esta operación."
          },
          "response": []
        }
      ]
    },
    {
      "name": "05 - Inscripciones",
      "description": "Inscripción, listado y retiro de equipos en torneos.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{authAdminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Listar equipos inscritos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tournaments/{{tournamentId}}/registrations?status=registered&page=1&limit=10",
            "description": "Lista las inscripciones del torneo. status puede ser registered o withdrawn."
          },
          "response": []
        },
        {
          "name": "Inscribir equipo en torneo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamId\": {{teamId}},\n  \"memberIds\": [{{captainId}}, {{userId}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/tournaments/{{tournamentId}}/registrations",
            "description": "Inscribe un equipo existente con el plantel seleccionado. El torneo debe estar en estado open, tener cupo y la cantidad de memberIds debe respetar sus límites."
          },
          "response": []
        },
        {
          "name": "Retirar equipo del torneo",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/tournaments/{{tournamentId}}/registrations/{{teamId}}",
            "description": "Realiza un retiro lógico de la inscripción mientras el torneo está open."
          },
          "response": []
        }
      ]
    },
    {
      "name": "06 - Autenticación y roles",
      "description": "Prueba registro, inicio de sesión y asignación de roles. Usá un ambiente con una cuenta administradora y un correo nuevo de prueba. Ejecutá las solicitudes en orden.",
      "item": [
        {
          "name": "Registrar participante",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"authUserId\");",
                  "pm.variables.set('authRequestBody', JSON.stringify({",
                  "  nombre: pm.variables.get(\"authName\"),",
                  "  email: pm.variables.get(\"authEmail\"),",
                  "  password: pm.variables.get(\"authPassword\"),",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Registro correcto\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const user = pm.response.json().data;",
                  "  pm.test('Devuelve el ID sin exponer la contraseña', () => {",
                  "    pm.expect(user.idUsuario).to.be.a('number').and.above(0);",
                  "    pm.expect(user).not.to.have.property('password');",
                  "  });",
                  "  if (Number.isInteger(user.idUsuario) && user.idUsuario > 0) {",
                  "    pm.environment.set('authUserId', String(user.idUsuario));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{authRequestBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Envía nombre, email y password desde authName, authEmail y authPassword. El servidor asigna el rol participante. Usá un correo nuevo para cada ejecución."
          },
          "response": []
        },
        {
          "name": "Iniciar sesión como participante",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"authParticipantToken\");",
                  "pm.variables.set('authRequestBody', JSON.stringify({",
                  "  email: pm.variables.get(\"authEmail\"),",
                  "  password: pm.variables.get(\"authPassword\"),",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Inicio de sesión correcto\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const token = pm.response.json().token;",
                  "  pm.test('La respuesta incluye un token', () => {",
                  "    pm.expect(token).to.be.a('string').and.not.empty;",
                  "  });",
                  "  if (typeof token === 'string' && token) pm.environment.set(\"authParticipantToken\", token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{authRequestBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Envía email y password desde authEmail y authPassword. Guarda el token en el ambiente activo."
          },
          "response": []
        },
        {
          "name": "Consultar sesión actual",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sesión activa de participante', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const user = pm.response.json().data;",
                  "  pm.expect(String(user.idUsuario)).to.eql(pm.variables.get('authUserId'));",
                  "  pm.expect(user.role).to.eql('participante');",
                  "  pm.expect(user).not.to.have.property('password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authParticipantToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Devuelve los datos y el rol actual de la cuenta autenticada. En el recorrido se usa el token del participante recién registrado."
          },
          "response": []
        },
        {
          "name": "Rechazar promoción sin permisos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Rechazar promoción sin permisos\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authParticipantToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"organizador\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users/{{authUserId}}/role",
            "description": "Comprueba que un participante no puede promover su propia cuenta. Debe responder 403."
          },
          "response": []
        },
        {
          "name": "Iniciar sesión como administrador",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"authAdminToken\");",
                  "pm.variables.set('authRequestBody', JSON.stringify({",
                  "  email: pm.variables.get(\"authAdminEmail\"),",
                  "  password: pm.variables.get(\"authAdminPassword\"),",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Inicio de sesión correcto\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const token = pm.response.json().token;",
                  "  pm.test('La respuesta incluye un token', () => {",
                  "    pm.expect(token).to.be.a('string').and.not.empty;",
                  "  });",
                  "  if (typeof token === 'string' && token) pm.environment.set(\"authAdminToken\", token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{authRequestBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Envía email y password desde authAdminEmail y authAdminPassword. Guarda el token en el ambiente activo."
          },
          "response": []
        },
        {
          "name": "Asignar rol de organizador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Asignar rol de organizador\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const user = pm.response.json().data;",
                  "  pm.test('El participante quedó como organizador', () => {",
                  "    pm.expect(user.role).to.eql('organizador');",
                  "    pm.expect(String(user.idUsuario)).to.eql(pm.variables.get('authUserId'));",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authAdminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"organizador\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users/{{authUserId}}/role",
            "description": "Promueve la cuenta nueva indicada por authUserId. Requiere el token obtenido con la cuenta administradora."
          },
          "response": []
        }
      ]
    }
  ]
}
